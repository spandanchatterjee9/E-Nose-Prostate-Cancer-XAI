{
  "name": "e-nose-prostate-cancer-dashboard-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File ./setup_local.ps1",
    "setup:bash": "bash ./setup_local.sh",
    "run": "powershell -ExecutionPolicy Bypass -File ./run_local.ps1",
    "run:bash": "bash ./run_local.sh",
    "frontend:install": "npm install --workspace=frontend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend"
  }
}
